{
  "name": "iaclaru",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/prerender.mjs && vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && node scripts/prerender.mjs && vite build && node scripts/postbuild.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler pages deploy dist --project-name iaclaru"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "^4.147.0"
  }
}
